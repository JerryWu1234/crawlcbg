# Copy to .env and fill in. .env is git-ignored.

CDP_URL=ws://127.0.0.1:9222/devtools/browser/

# Any OpenAI-compatible endpoint: OpenAI, a corporate LLM proxy, LiteLLM,
# vLLM, OpenRouter. Required.
LLM_API_KEY=your-api-key

# Base URL including the version prefix the endpoint expects.
# /chat/completions is appended. Required.
LLM_BASE_URL=https://api.openai.com/v1

# Selectable models for the PI Agent, JSON on one line. Required.
# "alias" is the stable key the UI sends, "model" is the id the endpoint
# expects; the first entry is the default selection.
# Optional per entry: label, detail, contextWindow, maxTokens, reasoning, compat.
LLM_MODELS=[{"alias":"flash","label":"Flash","detail":"默认 · 响应更快","model":"gpt-4o-mini","contextWindow":128000,"maxTokens":16384},{"alias":"pro","label":"Pro","detail":"深度分析","model":"o4-mini","contextWindow":200000,"maxTokens":100000,"reasoning":true}]

# Names the provider to pi-ai and selects its request-compatibility profile.
# Default "llm" yields plain OpenAI semantics. Set a known id such as "openai",
# "deepseek" or "anthropic" to turn on that family's quirks.
# LLM_PROVIDER_ID=llm

# Per-entry "compat" overrides the profile for one model. Needed when a single
# endpoint serves several families, or when it rejects part of the request:
#   {"compat":{"thinkingFormat":"deepseek","maxTokensField":"max_tokens"}}
#   {"compat":{"supportsDeveloperRole":false,"supportsStore":false}}

# Wire model id for the browser automation and script generation, which share
# one OpenAI-compatible client. Required.
LLM_UTILITY_MODEL=gpt-4o-mini

# List what the endpoint actually serves:
#   curl -H "Authorization: Bearer $LLM_API_KEY" "$LLM_BASE_URL/models"
