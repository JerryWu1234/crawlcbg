{
  "name": "crawlcbg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run --filter ./apps/* --parallel dev",
    "e2e": "vp run e2e:run",
    "e2e:open": "vp run e2e:open:run",
    "build": "vp run -r build",
    "runBuild": "vp run -r build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "cypress": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
